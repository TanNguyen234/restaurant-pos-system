# ==============================================================================
# RESTAURANT POS SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Hướng dẫn cấu hình chi tiết cho toàn bộ Backend ASP.NET Core & Dịch vụ F&B POS
# Sao chép file này thành .env để áp dụng cấu hình: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CSDL SQL SERVER (DATABASE CONFIGURATION)
# ------------------------------------------------------------------------------
# Chuỗi kết nối Entity Framework Core 10 (Chuẩn bị sẵn cho Windows Authentication):
ConnectionStrings__RestaurantPosDb=Server=localhost;Database=RestaurantPos_Acceptance;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Nếu máy chủ chạy bằng tài khoản SQL Server Authentication (sa):
# ConnectionStrings__RestaurantPosDb=Server=localhost,1433;Database=RestaurantPos_Acceptance;User Id=sa;Password=your_password;TrustServerCertificate=True;MultipleActiveResultSets=true;
DB_HOST=localhost
DB_PORT=1433
DB_NAME=RestaurantPos_Acceptance
DB_USERNAME=sa
DB_PASSWORD=your_password_here

# ------------------------------------------------------------------------------
# 2. XÁC THỰC JWT BEARER (AUTHENTICATION & RBAC)
# ------------------------------------------------------------------------------
# Khóa bí mật JWT tối thiểu 32 ký tự (Bắt buộc bảo mật cao trên Production)
Jwt__Key=RestaurantPosSecretKeyForJwtAuthentication2026!@#$%^&*()_+
Jwt__Issuer=RestaurantPosApi
Jwt__Audience=RestaurantPosClients
Jwt__ExpireMinutes=1440
APP_JWT_SECRET=RestaurantPosSecretKeyForJwtAuthentication2026!@#$%^&*()_+
APP_JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. CỔNG THANH TOÁN VNPAY SANDBOX (VNPAY PAYMENT GATEWAY)
# ------------------------------------------------------------------------------
# Thông tin cổng thử nghiệm VNPay (Tham khảo từ Wine-website):
VNP_TMN_CODE=L5GXH1AU
VNP_HASH_SECRET=EVCHM01XP0U7PT31IRMOJKC2IXRV2DW7
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5138/api/payment/vnpay/callback

# Định dạng ASP.NET Core nạp vào IConfiguration:
VNPay__TmnCode=L5GXH1AU
VNPay__HashSecret=EVCHM01XP0U7PT31IRMOJKC2IXRV2DW7
VNPay__Url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPay__ReturnUrl=http://localhost:5138/api/payment/vnpay/callback

# THÔNG TIN THẺ TEST VNPAY SANDBOX ĐỂ DEMO THANH TOÁN:
# - Ngân hàng:       NCB
# - Số thẻ:          9704198526191432198
# - Tên chủ thẻ:     NGUYEN VAN A
# - Ngày phát hành:  07/15
# - Mật khẩu OTP:    123456

# ------------------------------------------------------------------------------
# 4. CHUẨN THANH TOÁN VIETQR QUỐC GIA (NAPAS 247)
# ------------------------------------------------------------------------------
# Mã ngân hàng thụ hưởng (vietinbank, vcb, mbbank, tcb, acb, bidv, vpb,...)
VIETQR_BANK_ID=vietinbank
# Số tài khoản ngân hàng của nhà hàng nhận tiền chuyển khoản:
VIETQR_ACCOUNT_NO=102871234567
# Tên chủ tài khoản (Viết hoa không dấu):
VIETQR_ACCOUNT_NAME=NHA HANG POS SYSTEM

VietQR__BankId=vietinbank
VietQR__AccountNo=102871234567
VietQR__AccountName=NHA HANG POS SYSTEM

# ------------------------------------------------------------------------------
# 5. DỊCH VỤ EMAIL GMAIL SMTP (EMAIL OTP & QUÊN MẬT KHẨU - BAREM 1.8 & 1.9)
# ------------------------------------------------------------------------------
# Kích hoạt gửi email thật: true / false
ACCOUNT_EMAIL_ENABLED=true
# Địa chỉ Gmail người gửi:
EMAIL_USER=your_gmail_address@gmail.com
# Mật khẩu ứng dụng (App Password 16 ký tự tạo tại myaccount.google.com/apppasswords):
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=your_gmail_address@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true

Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=your_gmail_address@gmail.com
Smtp__Password=your_16_char_app_password
Smtp__FromEmail=your_gmail_address@gmail.com
Smtp__EnableSsl=true

# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI (GỢI Ý MÓN THỰC ĐƠN THÔNG MINH & TỰ ĐỘNG MÔ TẢ)
# ------------------------------------------------------------------------------
# Lấy API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ------------------------------------------------------------------------------
# 7. CỔNG THANH TOÁN STRIPE QUỐC TẾ (TÙY CHỌN VISA/MASTERCARD)
# ------------------------------------------------------------------------------
# Lấy key thử nghiệm tại: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ------------------------------------------------------------------------------
# 8. MÁY CHỦ ASP.NET CORE & CHÍNH SÁCH BẢO MẬT CORS
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://*:5138
ALLOWED_ORIGINS=http://localhost:5138,http://localhost:3000,http://127.0.0.1:5138

# ------------------------------------------------------------------------------
# 9. PHẦN CỨNG MÁY IN HÓA ĐƠN NHIỆT (ESC/POS THERMAL PRINTER)
# ------------------------------------------------------------------------------
# Khổ giấy in hóa đơn: 80mm hoặc 58mm
PRINTER_PAPER_SIZE=80mm
# Lệnh tự động cắt giấy sau khi in bill: true / false
PRINTER_AUTO_CUT=true
# Địa chỉ IP của máy in mạng LAN tại Bếp (In phiếu order món cho đầu bếp):
PRINTER_KITCHEN_IP=192.168.1.200
# Địa chỉ IP của máy in mạng LAN tại Quầy Thu Ngân (In phiếu tạm tính & hóa đơn):
PRINTER_CASHIER_IP=192.168.1.201
