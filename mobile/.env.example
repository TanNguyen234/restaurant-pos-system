# ==============================================================================
# RESTAURANT POS MOBILE CLIENT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Hướng dẫn cấu hình cho ứng dụng Flutter Mobile / Tablet / Web POS
# Sao chép file này thành .env hoặc dùng flag: --dart-define=POS_API_BASE_URL=...
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API BACKEND ENDPOINT (KẾT NỐI MÁY CHỦ REST API)
# ------------------------------------------------------------------------------
# - Khi chạy trên Windows Desktop hoặc Chrome Web:
POS_API_BASE_URL=http://localhost:5138

# - Khi chạy trên Android Emulator (máy ảo Android Studio):
# POS_API_BASE_URL=http://10.0.2.2:5138

# - Khi chạy trên Máy tính bảng (Tablet) hoặc Điện thoại thật qua mạng WiFi LAN:
# POS_API_BASE_URL=http://192.168.1.100:5138

# ------------------------------------------------------------------------------
# 2. THÔNG TIN NHÀ HÀNG HIỂN THỊ TRÊN HÓA ĐƠN & BÁO CÁO Z
# ------------------------------------------------------------------------------
POS_STORE_NAME=BISTRO POS RESTAURANT
POS_STORE_ADDRESS=123 Đường Ẩm Thực, Quận 1, TP. Hồ Chí Minh
POS_STORE_PHONE=0901234567

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH IN HÓA ĐƠN NHIỆT (THERMAL PRINTER PREVIEW)
# ------------------------------------------------------------------------------
POS_PRINTER_DEFAULT_WIDTH=80mm
POS_PRINTER_AUTO_PRINT_ON_PAYMENT=true
